# Paths are resolved by Docker Compose relative to this repository.
ANALYSIS_REPO=../control_flow
RAG_REPO=../cobol-rag-pipeline

# Team integration branch: https://github.com/erminlilaj/cobol-rekt
COBOL_REKT_REPO=../cobol-rekt

# Optional model overrides.
COBOL_RAG_LLM_MODEL=granite4.2:8b
COBOL_RAG_LLM_THINKING=false
COBOL_RAG_EMBEDDING_MODEL=mxbai-embed-large:latest
